# Classifier API image (Phase 2). Multi-stage:
#   1. trainer  — installs training deps and fine-tunes DistilBERT from the
#                 committed CSVs, producing the model at /build/model.
#   2. runtime  — installs only runtime deps and copies the trained model in.
# This keeps the runtime image free of pandas/scikit-learn and makes the model
# fully reproducible from source (no large binary committed to git).
#
# NOTE: build context is the REPO ROOT (set in docker-compose.yml) so the build
# can reach estc/data/training.

# ---- Stage 1: train the model ----
FROM python:3.11-slim AS trainer
WORKDIR /build
COPY estc/services/classifier_api/requirements.txt ./requirements.txt
COPY estc/services/classifier_api/requirements-train.txt ./requirements-train.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-train.txt
COPY estc/data/training ./estc/data/training
COPY estc/services/classifier_api/train.py ./estc/services/classifier_api/train.py
ENV CLASSIFIER_DATA_DIR=/build/estc/data/training \
    CLASSIFIER_MODEL_DIR=/build/model
RUN python estc/services/classifier_api/train.py

# ---- Stage 2: runtime ----
FROM python:3.11-slim AS runtime
WORKDIR /app
COPY estc/services/classifier_api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt
COPY estc/services/classifier_api/app ./app
# Vendor the dependency-free shared helpers (imported as estc.shared.*). /app is
# on sys.path, so the implicit namespace package resolves them; keeps a single
# source of truth across services.
COPY estc/shared/logging_setup.py ./estc/shared/logging_setup.py
COPY estc/shared/auth.py ./estc/shared/auth.py
COPY --from=trainer /build/model ./models/distilbert_intent

# Drop privileges: run as a non-root user (least privilege). Model + code are
# read-only at runtime, so no writable paths need chowning.
RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
