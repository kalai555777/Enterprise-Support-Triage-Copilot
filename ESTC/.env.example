GITHUB_PAT=
GITHUB_MOCK_PATH=estc/tests/fixtures/github_mock.json
HF_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=estc-dev
LANGSMITH_TRACING=true
POSTGRES_USER=estc
POSTGRES_PASSWORD=estc_dev_pw
POSTGRES_DB=estc
POSTGRES_HOST=mcp-postgres
POSTGRES_PORT=5432
POSTGRES_READER_USER=estc_reader
POSTGRES_READER_PASSWORD=estc_reader_dev_pw
CLASSIFIER_API_URL=http://classifier-api:8001

# --- Production hardening (all optional; empty/0/false = disabled) ---
# Shared secret required on the X-API-Key header between services (empty = no auth).
ESTC_API_KEY=
# Per-IP requests/minute on the orchestrator's public endpoints (0 = unlimited).
ESTC_RATE_LIMIT_PER_MIN=0
# Durable LangGraph checkpoints + ticket registry in Postgres (false = in-memory).
ESTC_PERSIST_POSTGRES=false
# Optional: directory of file-mounted secrets (Docker/K8s). Defaults to /run/secrets if present.
ESTC_SECRETS_DIR=